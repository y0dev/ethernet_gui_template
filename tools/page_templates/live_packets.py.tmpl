# template: Live table of packets from every connection, with pause and clear
"""$title page (plugin).

Generated by tools/new_page.py from the "live_packets" template.  It
subscribes to ``ctx.capture.packets_added`` (batched, so a fast device does
not flood the GUI) and shows the newest ``MAX_ROWS`` packets.  Change
``accepts()`` to show only the traffic you care about.
"""

from __future__ import annotations

from PySide6.QtWidgets import QLabel, QPushButton, QTableWidget, QTableWidgetItem, QVBoxLayout, QWidget

from app.core.hexutil import format_hex, to_ascii
from app.core.models import Packet
from app.ui.widgets.common import PageHeader, configure_table
from app.ui.widgets.table_models import format_timestamp

MAX_ROWS = 500
HEADERS = ["Time", "Dir", "Source", "Destination", "Len", "Data (HEX)", "ASCII"]


def accepts(packet: Packet) -> bool:
    """Decide whether a packet is shown on this page.

    Args:
        packet: Packet sent or received on any connection.

    Returns:
        True to show the packet. Every packet is shown by default.
    """
    return True


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None) -> None:
        """Build the packet table and subscribe to live capture.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
        """
        super().__init__(parent)
        self.ctx = ctx
        self.paused = False
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 14, 18, 14)
        header = PageHeader("$title", "Live traffic on every open connection.")
        self.pause_button = QPushButton("Pause")
        self.pause_button.setCheckable(True)
        self.pause_button.toggled.connect(self.set_paused)
        clear = QPushButton("Clear")
        clear.clicked.connect(self.clear_packets)
        header.actions.addWidget(self.pause_button)
        header.actions.addWidget(clear)
        layout.addWidget(header)
        self.table = QTableWidget(0, len(HEADERS))
        self.table.setHorizontalHeaderLabels(HEADERS)
        configure_table(self.table)
        layout.addWidget(self.table, 1)
        self.status = QLabel("Waiting for packets…")
        self.status.setObjectName("Dim")
        layout.addWidget(self.status)
        ctx.capture.packets_added.connect(self.add_packets)

    def add_packets(self, packets: list[Packet]) -> None:
        """Append a batch of live packets, keeping only the newest ``MAX_ROWS``.

        Args:
            packets: Packets captured since the last batch.
        """
        if self.paused:
            return
        for packet in (p for p in packets if accepts(p)):
            row = self.table.rowCount()
            self.table.insertRow(row)
            values = [format_timestamp(packet.timestamp), packet.direction.value, packet.source,
                      packet.destination, str(packet.length), format_hex(packet.data[:32]),
                      to_ascii(packet.data[:32])]
            for column, value in enumerate(values):
                self.table.setItem(row, column, QTableWidgetItem(value))
        while self.table.rowCount() > MAX_ROWS:
            self.table.removeRow(0)
        self.table.scrollToBottom()
        self.status.setText(f"{self.table.rowCount()} packet(s) shown")

    def set_paused(self, paused: bool) -> None:
        """Stop or resume adding packets to the table.

        Args:
            paused: True to pause.
        """
        self.paused = paused
        self.pause_button.setText("Resume" if paused else "Pause")

    def clear_packets(self) -> None:
        """Remove every row from the table."""
        self.table.setRowCount(0)
        self.status.setText("Cleared")


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
