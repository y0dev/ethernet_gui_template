# template: Operations menu as a C-style console: numbered text menu, "Enter choice:" prompt, inputs asked one by one
"""$title page (plugin).

Generated by tools/new_page.py from the "menu_console" template: the menu
hooks (project.json -> menu_hooks) as a text console, like the C test program
it replaces. Type an option's number and press Enter; options with inputs ask
for each value in turn (Enter keeps the value shown in brackets).

Commands: a number runs that option, ``m`` prints the menu again, ``r``
reloads the hook files, ``s`` stops running hooks, ``c`` clears the screen.

Use it as a tab, or as step 4 of the Session Workflow:
``python tools/new_page.py <key> "<Title>" --template menu_console --workflow``.
Change the look in ``print_menu()`` and the prompts in ``ask_next_input()``.
"""

from __future__ import annotations

from typing import Any

from PySide6.QtWidgets import QHBoxLayout, QLabel, QLineEdit, QSplitter, QVBoxLayout, QWidget

from app.core.services.menu_hooks import MenuOption
from app.ui.styles import theme
from app.ui.widgets.common import PageHeader
from app.ui.widgets.hook_widgets import DeviceTargets, HookLauncher, HookLog, WorkflowStatus, load_options


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None, embedded: bool = False) -> None:
        """Build the device list, the console and the prompt.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
            embedded: Shown as step 4 of the Session Workflow (no title or margins).
        """
        super().__init__(parent)
        self.ctx = ctx
        self.wf = ctx.workflow
        self.options: list[MenuOption] = []
        # An option waiting for its inputs: the option, the inputs still to ask, the values so far.
        self.pending: tuple[MenuOption, list, dict[str, Any]] | None = None

        layout = QVBoxLayout(self)
        layout.setContentsMargins(*((0, 0, 0, 0) if embedded else (18, 14, 18, 14)))
        if not embedded:
            layout.addWidget(PageHeader("$title", "Type a number and press Enter, like the C console menu."))
        self.status = WorkflowStatus(self.wf)
        layout.addWidget(self.status)

        split = QSplitter()
        self.targets = DeviceTargets(self.wf)
        split.addWidget(self.targets)
        console = QWidget()
        clayout = QVBoxLayout(console)
        clayout.setContentsMargins(0, 0, 0, 0)
        self.log = HookLog()
        self.log.setStyleSheet(f"background: {theme.BG}; border: 1px solid {theme.BORDER};")
        clayout.addWidget(self.log, 1)
        row = QHBoxLayout()
        self.prompt = QLabel("Enter choice:")
        self.prompt.setFont(theme.monospace_font(10))
        self.entry = QLineEdit()
        self.entry.setFont(theme.monospace_font(10))
        self.entry.returnPressed.connect(self.submit)
        row.addWidget(self.prompt)
        row.addWidget(self.entry, 1)
        clayout.addLayout(row)
        split.addWidget(console)
        split.setStretchFactor(0, 1)
        split.setStretchFactor(1, 3)
        layout.addWidget(split, 1)

        self.launcher = HookLauncher(self.wf, self.log, self)
        self.reload_hooks()

    @property
    def runs(self) -> list:
        """Hook runs still in progress."""
        return self.launcher.runs

    # -- console ----------------------------------------------------------
    def say(self, text: str, color: str = "") -> None:
        """Print a line on the console without a timestamp.

        Args:
            text: Line to print (spaces are kept).
            color: Text colour, default the theme's text colour.
        """
        from html import escape

        self.log.appendHtml(f'<span style="color:{color or theme.TEXT}; white-space:pre">{escape(text)}</span>')

    def print_menu(self) -> None:
        """Print the numbered menu, one block per category."""
        self.say("")
        self.say("==== $title ====", theme.ACCENT)
        category = None
        for number, option in enumerate(self.options, start=1):
            if option.category != category:
                category = option.category
                self.say(f"  [{category}]", theme.TEXT_DIM)
            inputs = f"  ({', '.join(p.label or p.name for p in option.params)})" if option.params else ""
            self.say(f"  {number:>2}) {option.title}{inputs}")
        self.say("   m) menu   r) reload   s) stop   c) clear", theme.TEXT_DIM)

    def reload_hooks(self) -> None:
        """Re-import the hook files and print the menu."""
        self.options, problems = load_options(self.ctx.menu_hooks)
        for problem in problems:
            self.log.append("error", f"hooks: {problem}")
        self.print_menu()

    def submit(self) -> None:
        """Handle the line typed at the prompt: an input value, a command or a choice."""
        text = self.entry.text().strip()
        self.entry.clear()
        if self.pending is not None:
            self.take_input(text)
            return
        self.say(f"> {text}", theme.ACCENT)
        commands = {"m": self.print_menu, "r": self.reload_hooks, "s": self.launcher.stop_all, "c": self.log.clear}
        if text.lower() in commands:
            commands[text.lower()]()
        elif text.isdigit() and 1 <= int(text) <= len(self.options):
            self.choose(self.options[int(text) - 1])
        else:
            self.say(f"Invalid choice. Enter 1-{len(self.options)}, or m, r, s, c.", theme.WARN)

    def choose(self, option: MenuOption) -> None:
        """Start asking for an option's inputs, or run it straight away if it has none.

        Args:
            option: The chosen option.
        """
        last = self.launcher.last_values.get(f"{option.module}:{option.title}", {})
        defaults = {p.name: last.get(p.name, p.default) for p in option.params}
        self.pending = (option, list(option.params), defaults)
        self.ask_next_input()

    def ask_next_input(self) -> None:
        """Prompt for the next input, or run the option once every input is known."""
        option, todo, values = self.pending
        if not todo:
            self.pending = None
            self.prompt.setText("Enter choice:")
            self.run_option(option, values)
            return
        param = todo[0]
        hint = f" {param.choices}" if param.choices else (" (y/n)" if param.value_type is bool else "")
        self.prompt.setText(f"{param.label or param.name}{hint} [{values[param.name]}]:")

    def take_input(self, text: str) -> None:
        """Store one typed input value (empty keeps the default) and ask for the next.

        Args:
            text: The typed value.
        """
        option, todo, values = self.pending
        param = todo[0]
        self.say(f"{self.prompt.text()} {text}", theme.TEXT_DIM)
        if text:
            try:
                values[param.name] = self.parse(param, text)
            except ValueError as exc:
                self.say(f"  {exc}", theme.WARN)
                return
        todo.pop(0)
        self.ask_next_input()

    @staticmethod
    def parse(param, text: str) -> Any:
        """Convert typed text to a parameter's type.

        Args:
            param: The parameter.
            text: Typed text.

        Returns:
            The value.

        Raises:
            ValueError: If the text does not fit the parameter.
        """
        kind = param.value_type
        if param.choices:
            for choice in param.choices:
                if str(choice).lower() == text.lower():
                    return choice
            raise ValueError(f"choose one of {param.choices}")
        if kind is bool:
            if text.lower() in ("y", "yes", "1", "true", "on"):
                return True
            if text.lower() in ("n", "no", "0", "false", "off"):
                return False
            raise ValueError("answer y or n")
        value = kind(text)
        if param.minimum is not None and value < param.minimum or param.maximum is not None and value > param.maximum:
            raise ValueError(f"must be between {param.minimum} and {param.maximum}")
        return value

    # -- used by the Session Workflow (right-click a device -> Run operation) --
    def set_targets(self, peers: list[str]) -> None:
        """Tick exactly these devices.

        Args:
            peers: Device addresses.
        """
        self.targets.set_targets(peers)

    def ticked_peers(self) -> list[str]:
        """Return the addresses of the ticked devices."""
        return self.targets.ticked_peers()

    def run_option(self, option: MenuOption, values: dict[str, Any] | None = None) -> list:
        """Run an option on every ticked device.

        Args:
            option: Option to run.
            values: Input values; None asks for them at the prompt.

        Returns:
            The started runs.
        """
        if values is None:
            self.choose(option)
            return []
        targets = self.targets.ticked()
        problem = self.launcher.problem(targets)
        if problem:
            self.say(problem, theme.WARN)
            return []
        return self.launcher.start(option, targets, values)


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
