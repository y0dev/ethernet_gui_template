# template: Send HEX/ASCII to an open connection and show what comes back
"""$title page (plugin).

Generated by tools/new_page.py from the "device_console" template.  Pick an
open connection (Network Connections page), type a message and send it;
every frame received on that connection is appended to the log.  Replace
``format_frame()`` to show decoded fields instead of raw bytes.
"""

from __future__ import annotations

from PySide6.QtWidgets import QComboBox, QHBoxLayout, QLineEdit, QPushButton, QVBoxLayout, QWidget

from app.core.hexutil import format_hex, parse_ascii, parse_hex, to_ascii
from app.core.models import Direction, Packet
from app.ui.widgets.common import HexView, PageHeader, show_error
from app.ui.widgets.table_models import format_timestamp


def format_frame(packet: Packet) -> str:
    """Render one frame for the log.

    Args:
        packet: Frame sent or received on the selected connection.

    Returns:
        One log line with time, direction, hex and ASCII.
    """
    return (f"{format_timestamp(packet.timestamp)}  {packet.direction.value}  "
            f"{format_hex(packet.data)}  |{to_ascii(packet.data)}|")


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None) -> None:
        """Build the connection picker, message input and frame log.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
        """
        super().__init__(parent)
        self.ctx = ctx
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 14, 18, 14)
        header = PageHeader("$title", "Send a message to a device and watch its replies.")
        refresh = QPushButton("Refresh connections")
        refresh.clicked.connect(self.reload_connections)
        header.actions.addWidget(refresh)
        layout.addWidget(header)
        row = QHBoxLayout()
        self.connection = QComboBox()
        self.mode = QComboBox()
        self.mode.addItems(["HEX", "ASCII"])
        self.message = QLineEdit()
        self.message.setPlaceholderText("HEX: 01 02 0A   |   ASCII: PING\\n")
        self.message.returnPressed.connect(self.send_message)
        send = QPushButton("Send")
        send.setObjectName("Primary")
        send.clicked.connect(self.send_message)
        for widget in (self.connection, self.mode):
            row.addWidget(widget)
        row.addWidget(self.message, 1)
        row.addWidget(send)
        layout.addLayout(row)
        self.log = HexView()
        layout.addWidget(self.log, 1)
        ctx.connections.packet.connect(self.show_frame)
        ctx.connections.configs_changed.connect(self.reload_connections)
        self.reload_connections()

    def reload_connections(self) -> None:
        """Refill the connection picker from the stored connections, keeping the choice."""
        current = self.connection.currentData()
        self.connection.clear()
        for config in self.ctx.connections.configs():
            self.connection.addItem(config.name, config.id)
        self.connection.setCurrentIndex(max(0, self.connection.findData(current)))

    def send_message(self) -> None:
        """Parse the message and send it on the selected connection.

        Parse and send errors are shown in a dialog.
        """
        connection_id = self.connection.currentData()
        if connection_id is None:
            show_error(self, "Send", "Create and open a connection first (Network Connections page).")
            return
        try:
            text = self.message.text()
            data = parse_hex(text) if self.mode.currentText() == "HEX" else parse_ascii(text)
        except ValueError as exc:
            show_error(self, "Send", exc)
            return
        if data and not self.ctx.connections.send(connection_id, data):
            endpoint = self.ctx.connections.endpoint(connection_id)
            show_error(self, "Send", endpoint.last_error if endpoint else "The connection is not open.")

    def show_frame(self, packet: Packet) -> None:
        """Append a frame of the selected connection to the log.

        Args:
            packet: Frame sent or received on any connection.
        """
        if packet.connection_id != self.connection.currentData():
            return
        prefix = "<< " if packet.direction is Direction.RX else ">> "
        self.log.appendPlainText(prefix + format_frame(packet))


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
