# template: Input form built from a named query's :parameters, results in a table
"""$title page (plugin).

Generated by tools/new_page.py from the "query_form" template.  The form
gets one input per ``:parameter`` of ``QUERY`` (a named query from
app/core/database/sql/ or sql/*.sql); Run executes it and shows the rows.
Point ``QUERY`` at your own query to reuse the page.
"""

from __future__ import annotations

from typing import Any

from PySide6.QtWidgets import (
    QFormLayout,
    QLabel,
    QLineEdit,
    QPushButton,
    QTableWidget,
    QTableWidgetItem,
    QVBoxLayout,
    QWidget,
)

from app.ui.widgets.common import PageHeader, configure_table, show_error

#: named query this page runs; its :parameters become the form fields
QUERY = "report.traffic"


def parse_param(text: str) -> Any:
    """Convert form text to a query parameter value.

    Args:
        text: Text typed in a form field.

    Returns:
        An int or float if the text parses as one, None for empty text,
        otherwise the stripped text.
    """
    value = text.strip()
    if not value:
        return None
    for kind in (int, float):
        try:
            return kind(value)
        except ValueError:
            pass
    return value


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None) -> None:
        """Build one input per query parameter, a Run button and the result table.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
        """
        super().__init__(parent)
        self.ctx = ctx
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 14, 18, 14)
        query = ctx.db.sql.get(QUERY)
        header = PageHeader("$title", query.description or f"Runs the named query {QUERY}.")
        run = QPushButton("Run")
        run.setObjectName("Primary")
        run.clicked.connect(self.run_query)
        header.actions.addWidget(run)
        layout.addWidget(header)
        form = QFormLayout()
        self.inputs: dict[str, QLineEdit] = {}
        for name in query.parameters:
            edit = QLineEdit()
            edit.setPlaceholderText("number or text; empty = NULL")
            edit.returnPressed.connect(self.run_query)
            form.addRow(name.replace("_", " ").capitalize(), edit)
            self.inputs[name] = edit
        layout.addLayout(form)
        self.table = QTableWidget()
        configure_table(self.table)
        layout.addWidget(self.table, 1)
        self.status = QLabel("")
        self.status.setObjectName("Dim")
        layout.addWidget(self.status)

    def run_query(self) -> None:
        """Run ``QUERY`` with the form values and show the rows.

        Errors are shown in a dialog.
        """
        params = {name: parse_param(edit.text()) for name, edit in self.inputs.items()}
        try:
            rows = self.ctx.db.run(QUERY, **params)
        except Exception as exc:
            show_error(self, "$title", exc)
            return
        headers = list(rows[0].keys()) if rows else []
        self.table.clear()
        self.table.setColumnCount(len(headers))
        self.table.setHorizontalHeaderLabels(headers)
        self.table.setRowCount(len(rows))
        for r, row in enumerate(rows):
            for c, value in enumerate(row):
                self.table.setItem(r, c, QTableWidgetItem("NULL" if value is None else str(value)))
        self.table.resizeColumnsToContents()
        self.status.setText(f"{len(rows)} row(s) from {QUERY}")


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
