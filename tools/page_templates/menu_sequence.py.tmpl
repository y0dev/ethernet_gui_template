# template: Operations menu as a test sequence: build an ordered list of options, run it on every device, results grid
"""$title page (plugin).

Generated by tools/new_page.py from the "menu_sequence" template: build a
test procedure from the menu hooks (project.json -> menu_hooks) and run it
on every ticked device. Double-click an option (or press Add) to append it to
the sequence, with its inputs; reorder with Up / Down. Run sequence runs the
steps in order on each device, devices in parallel, and fills the grid:
one row per device, one column per step. Save / Load keep a sequence as JSON.

Use it as a tab, or as step 4 of the Session Workflow:
``python tools/new_page.py <key> "<Title>" --template menu_sequence --workflow``.
"""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from PySide6.QtCore import Qt, QTimer
from PySide6.QtGui import QColor
from PySide6.QtWidgets import (
    QCheckBox,
    QFileDialog,
    QGroupBox,
    QHBoxLayout,
    QListWidget,
    QListWidgetItem,
    QPushButton,
    QSplitter,
    QTableWidget,
    QTableWidgetItem,
    QVBoxLayout,
    QWidget,
)

from app.core.services.menu_hooks import MenuOption
from app.ui.styles import theme
from app.ui.widgets.common import PageHeader, configure_table, show_error
from app.ui.widgets.hook_widgets import DeviceTargets, HookLauncher, HookLog, WorkflowStatus, load_options

STATE_COLORS = {"done": "OK", "failed": "ERROR", "error": "ERROR", "cancelled": "WARN", "skipped": "TEXT_DIM"}


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None, embedded: bool = False) -> None:
        """Build the devices, the option list, the sequence editor, the results grid and the log.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
            embedded: Shown as step 4 of the Session Workflow (no title or margins).
        """
        super().__init__(parent)
        self.ctx = ctx
        self.wf = ctx.workflow
        self.options: list[MenuOption] = []
        #: the sequence: (option, input values) in order
        self.steps: list[tuple[MenuOption, dict[str, Any]]] = []
        self._targets: list[tuple[str, str]] = []     # devices of the current run
        self._cells: dict[int, tuple[int, int]] = {}  # id(run) -> (device row, step column)
        self._next_cell: tuple[int, int] | None = None
        self._stopped = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(*((0, 0, 0, 0) if embedded else (18, 14, 18, 14)))
        header = PageHeader("$title", "Build a sequence of options and run it on every ticked device.")
        if embedded:
            header.findChild(QWidget, "PageTitle").hide()
        for text, slot in (("Reload hooks", self.reload_hooks), ("Load…", self.load_sequence),
                           ("Save…", self.save_sequence)):
            button = QPushButton(text)
            button.clicked.connect(slot)
            header.actions.addWidget(button)
        layout.addWidget(header)
        self.status = WorkflowStatus(self.wf)
        layout.addWidget(self.status)

        top = QSplitter()
        self.targets = DeviceTargets(self.wf)
        top.addWidget(self.targets)
        available = QGroupBox("Options (double-click to add)")
        alayout = QVBoxLayout(available)
        self.available = QListWidget()
        self.available.itemDoubleClicked.connect(lambda _item: self.add_selected())
        alayout.addWidget(self.available)
        add = QPushButton("Add →")
        add.clicked.connect(self.add_selected)
        alayout.addWidget(add)
        top.addWidget(available)

        sequence = QGroupBox("Sequence")
        slayout = QVBoxLayout(sequence)
        self.sequence = QListWidget()
        slayout.addWidget(self.sequence, 1)
        srow = QHBoxLayout()
        for text, slot in (("Up", lambda: self.move(-1)), ("Down", lambda: self.move(1)),
                           ("Remove", self.remove_selected), ("Clear", self.clear_steps)):
            button = QPushButton(text)
            button.clicked.connect(slot)
            srow.addWidget(button)
        slayout.addLayout(srow)
        self.stop_on_fail = QCheckBox("Stop a device at its first failure")
        self.stop_on_fail.setChecked(True)
        slayout.addWidget(self.stop_on_fail)
        rrow = QHBoxLayout()
        run = QPushButton("Run sequence")
        run.setObjectName("Primary")
        run.clicked.connect(self.run_sequence)
        stop = QPushButton("Stop")
        stop.setObjectName("Danger")
        stop.clicked.connect(self.stop)
        rrow.addWidget(run, 1)
        rrow.addWidget(stop)
        slayout.addLayout(rrow)
        top.addWidget(sequence)

        split = QSplitter(Qt.Orientation.Vertical)
        split.addWidget(top)
        self.grid = QTableWidget(0, 0)
        configure_table(self.grid, stretch_last=False)
        self.grid.verticalHeader().setVisible(True)   # device names label the rows
        split.addWidget(self.grid)
        self.log = HookLog()
        split.addWidget(self.log)
        split.setStretchFactor(0, 3)
        split.setStretchFactor(1, 2)
        split.setStretchFactor(2, 1)
        layout.addWidget(split, 1)

        self.launcher = HookLauncher(self.wf, self.log, self)
        self.launcher.run_started.connect(self._on_started)
        self.launcher.run_finished.connect(self._on_finished)
        self.reload_hooks()

    @property
    def runs(self) -> list:
        """Hook runs still in progress."""
        return self.launcher.runs

    # -- building the sequence --------------------------------------------
    def reload_hooks(self) -> None:
        """Re-import the hook files and refill the option list."""
        self.options, problems = load_options(self.ctx.menu_hooks)
        self.available.clear()
        for number, option in enumerate(self.options, start=1):
            item = QListWidgetItem(f"{number}. {option.category} / {option.title}")
            item.setData(Qt.ItemDataRole.UserRole, number - 1)
            item.setToolTip(option.description)
            self.available.addItem(item)
        for problem in problems:
            self.log.append("error", f"hooks: {problem}")

    def add_step(self, option: MenuOption, values: dict[str, Any]) -> None:
        """Append a step to the sequence.

        Args:
            option: The option.
            values: Its input values.
        """
        self.steps.append((option, dict(values)))
        self._show_steps()

    def add_selected(self) -> None:
        """Append the selected option, asking for its inputs first."""
        item = self.available.currentItem()
        if item is None:
            return
        option = self.options[item.data(Qt.ItemDataRole.UserRole)]
        values = self.launcher.ask_values(option, self)
        if values is not None:
            self.add_step(option, values)

    def move(self, offset: int) -> None:
        """Move the selected step up or down.

        Args:
            offset: -1 for up, 1 for down.
        """
        row = self.sequence.currentRow()
        target = row + offset
        if 0 <= row < len(self.steps) and 0 <= target < len(self.steps):
            self.steps[row], self.steps[target] = self.steps[target], self.steps[row]
            self._show_steps()
            self.sequence.setCurrentRow(target)

    def remove_selected(self) -> None:
        """Remove the selected step."""
        row = self.sequence.currentRow()
        if 0 <= row < len(self.steps):
            del self.steps[row]
            self._show_steps()

    def clear_steps(self) -> None:
        """Remove every step."""
        self.steps.clear()
        self._show_steps()

    def _show_steps(self) -> None:
        """Redraw the sequence list."""
        self.sequence.clear()
        for number, (option, values) in enumerate(self.steps, start=1):
            shown = ", ".join(f"{k}={v}" for k, v in values.items())
            self.sequence.addItem(f"{number}. {option.title}" + (f"  ({shown})" if shown else ""))

    def save_sequence(self) -> None:
        """Save the sequence as JSON (option titles and input values)."""
        path, _ = QFileDialog.getSaveFileName(self, "Save sequence", "sequence.json", "Sequence (*.json)")
        if path:
            data = [{"option": o.title, "values": v} for o, v in self.steps]
            Path(path).write_text(json.dumps(data, indent=2), encoding="utf-8")

    def load_sequence(self, path: str = "") -> None:
        """Load a sequence saved with Save; unknown option titles are reported and skipped.

        Args:
            path: File to load; empty asks for one.
        """
        if not path:
            path, _ = QFileDialog.getOpenFileName(self, "Load sequence", "", "Sequence (*.json)")
            if not path:
                return
        by_title = {o.title: o for o in self.options}
        self.steps.clear()
        for entry in json.loads(Path(path).read_text(encoding="utf-8")):
            option = by_title.get(entry.get("option"))
            if option is None:
                self.log.append("warn", f"sequence: no option called {entry.get('option')!r}")
                continue
            self.steps.append((option, entry.get("values", {})))
        self._show_steps()

    # -- running ----------------------------------------------------------
    def run_sequence(self) -> None:
        """Run every step in order on each ticked device (devices in parallel)."""
        targets = self.targets.ticked()
        problem = self.launcher.problem(targets) or ("" if self.steps else "Add at least one step.")
        if problem:
            show_error(self, "Run sequence", problem)
            return
        self._targets, self._stopped = targets, False
        self.grid.clear()
        self.grid.setRowCount(len(targets))
        self.grid.setColumnCount(len(self.steps))
        self.grid.setHorizontalHeaderLabels([f"{i}. {o.title}" for i, (o, _v) in enumerate(self.steps, 1)])
        self.grid.setVerticalHeaderLabels([label for _peer, label in targets])
        for row in range(len(targets)):
            self._run_step(row, 0)
        self.grid.resizeColumnsToContents()

    def _run_step(self, row: int, column: int) -> None:
        """Start one step on one device.

        Args:
            row: Device row in the grid.
            column: Step index.
        """
        if self._stopped or column >= len(self.steps):
            return
        option, values = self.steps[column]
        self._set_cell(row, column, "running…", "TEXT")
        self._next_cell = (row, column)
        self.launcher.start(option, [self._targets[row]], values)

    def _on_started(self, run) -> None:
        """Remember which grid cell a run belongs to.

        Args:
            run: The run that is starting.
        """
        if self._next_cell is not None:
            self._cells[id(run)] = self._next_cell
            self._next_cell = None

    def _on_finished(self, run) -> None:
        """Show a step's result and start the device's next step.

        Args:
            run: The finished run.
        """
        cell = self._cells.pop(id(run), None)
        if cell is None:
            return
        row, column = cell
        self._set_cell(row, column, run.state.upper(), STATE_COLORS.get(run.state, "WARN"))
        if run.state != "done" and self.stop_on_fail.isChecked():
            for later in range(column + 1, len(self.steps)):
                self._set_cell(row, later, "skipped", "TEXT_DIM")
            return
        QTimer.singleShot(0, lambda: self._run_step(row, column + 1))

    def _set_cell(self, row: int, column: int, text: str, color: str) -> None:
        """Write a grid cell in a theme colour.

        Args:
            row: Device row.
            column: Step column.
            text: Cell text.
            color: Theme colour name, e.g. ``"OK"``.
        """
        item = QTableWidgetItem(text)
        item.setForeground(QColor(getattr(theme, color)))
        item.setTextAlignment(Qt.AlignmentFlag.AlignCenter)
        self.grid.setItem(row, column, item)

    def stop(self) -> None:
        """Stop every device's sequence; requests already queued still complete."""
        self._stopped = True
        self.launcher.stop_all()

    # -- used by the Session Workflow (right-click a device -> Run operation) --
    def set_targets(self, peers: list[str]) -> None:
        """Tick exactly these devices.

        Args:
            peers: Device addresses.
        """
        self.targets.set_targets(peers)

    def ticked_peers(self) -> list[str]:
        """Return the addresses of the ticked devices."""
        return self.targets.ticked_peers()

    def run_option(self, option: MenuOption, values: dict[str, Any] | None = None) -> list:
        """Run a single option on every ticked device, outside the sequence.

        Args:
            option: Option to run.
            values: Input values; None asks with a dialog when the option has inputs.

        Returns:
            The started runs.
        """
        targets = self.targets.ticked()
        problem = self.launcher.problem(targets)
        if problem:
            show_error(self, option.title, problem)
            return []
        if values is None:
            values = self.launcher.ask_values(option, self)
            if values is None:
                return []
        return self.launcher.start(option, targets, values)


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
