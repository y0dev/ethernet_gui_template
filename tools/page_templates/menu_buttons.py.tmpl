# template: Operations menu as big buttons: one button per option, grouped by category, coloured by last result
"""$title page (plugin).

Generated by tools/new_page.py from the "menu_buttons" template: the menu
hooks (project.json -> menu_hooks) as a panel of large buttons, for operators
and touch screens. Tick devices on the left and press a button; options with
inputs ask for them first. After a run, the button's border shows the result
(green: every device passed, red: any failed).

Use it as a tab, or as step 4 of the Session Workflow:
``python tools/new_page.py <key> "<Title>" --template menu_buttons --workflow``.
Change ``COLUMNS`` for a wider or narrower grid.
"""

from __future__ import annotations

from typing import Any

from PySide6.QtCore import Qt
from PySide6.QtWidgets import (
    QGridLayout,
    QGroupBox,
    QPushButton,
    QScrollArea,
    QSplitter,
    QVBoxLayout,
    QWidget,
)

from app.core.services.menu_hooks import MenuOption
from app.ui.styles import theme
from app.ui.widgets.common import PageHeader, show_error
from app.ui.widgets.hook_widgets import DeviceTargets, HookLauncher, HookLog, WorkflowStatus, load_options

#: buttons per row
COLUMNS = 3
#: border colour after a run, by worst result
RESULT_BORDERS = {"done": "OK", "failed": "ERROR", "error": "ERROR", "cancelled": "WARN"}


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None, embedded: bool = False) -> None:
        """Build the device list, the button panel and the log.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
            embedded: Shown as step 4 of the Session Workflow (no title or margins).
        """
        super().__init__(parent)
        self.ctx = ctx
        self.wf = ctx.workflow
        self.options: list[MenuOption] = []
        self.buttons: dict[str, QPushButton] = {}
        # Results of the current batch per option title, to colour its button when all are in.
        self.batches: dict[str, list[str]] = {}

        layout = QVBoxLayout(self)
        layout.setContentsMargins(*((0, 0, 0, 0) if embedded else (18, 14, 18, 14)))
        header = PageHeader("$title", "Tick devices, then press an option.")
        if embedded:
            header.findChild(QWidget, "PageTitle").hide()
        for text, slot in (("Reload hooks", self.reload_hooks), ("Stop all", lambda: self.launcher.stop_all())):
            button = QPushButton(text)
            button.clicked.connect(slot)
            header.actions.addWidget(button)
        layout.addWidget(header)
        self.status = WorkflowStatus(self.wf)
        layout.addWidget(self.status)

        top = QSplitter()
        self.targets = DeviceTargets(self.wf)
        top.addWidget(self.targets)
        self.panel = QWidget()
        self.grid = QVBoxLayout(self.panel)
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(self.panel)
        top.addWidget(scroll)
        top.setSizes([260, 900])          # narrow device list, wide button panel
        split = QSplitter(Qt.Orientation.Vertical)
        split.addWidget(top)
        self.log = HookLog()
        split.addWidget(self.log)
        split.setStretchFactor(0, 3)
        split.setStretchFactor(1, 1)
        layout.addWidget(split, 1)

        self.launcher = HookLauncher(self.wf, self.log, self)
        self.launcher.run_finished.connect(self._on_finished)
        self.reload_hooks()

    @property
    def runs(self) -> list:
        """Hook runs still in progress."""
        return self.launcher.runs

    def reload_hooks(self) -> None:
        """Re-import the hook files and rebuild the buttons."""
        self.options, problems = load_options(self.ctx.menu_hooks)
        while self.grid.count():
            item = self.grid.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        self.buttons.clear()
        groups: dict[str, QGridLayout] = {}
        for number, option in enumerate(self.options, start=1):
            grid = groups.get(option.category)
            if grid is None:
                box = QGroupBox(option.category)
                grid = groups[option.category] = QGridLayout(box)
                self.grid.addWidget(box)
            button = QPushButton(f"{number}   {option.title}" + ("  …" if option.params else ""))
            button.setMinimumHeight(52)
            button.setToolTip(option.description)
            button.clicked.connect(lambda _c=False, o=option: self.run_option(o))
            index = grid.count()
            grid.addWidget(button, index // COLUMNS, index % COLUMNS)
            self.buttons[option.title] = button
        self.grid.addStretch(1)
        for problem in problems:
            self.log.append("error", f"hooks: {problem}")

    def _on_finished(self, run) -> None:
        """Colour an option's button once every device of its batch has finished.

        Args:
            run: The finished hook run.
        """
        title = run.option.title
        results = self.batches.setdefault(title, [])
        results.append(run.state)
        if any(r.option.title == title for r in self.launcher.runs):
            return
        worst = "done" if all(s == "done" for s in results) else next(s for s in results if s != "done")
        color = getattr(theme, RESULT_BORDERS.get(worst, "WARN"))
        button = self.buttons.get(title)
        if button is not None:
            button.setStyleSheet(f"border: 2px solid {color};")
        self.batches.pop(title, None)

    # -- used by the Session Workflow (right-click a device -> Run operation) --
    def set_targets(self, peers: list[str]) -> None:
        """Tick exactly these devices.

        Args:
            peers: Device addresses.
        """
        self.targets.set_targets(peers)

    def ticked_peers(self) -> list[str]:
        """Return the addresses of the ticked devices."""
        return self.targets.ticked_peers()

    def run_option(self, option: MenuOption, values: dict[str, Any] | None = None) -> list:
        """Run an option on every ticked device, asking for its inputs first.

        Args:
            option: Option to run.
            values: Input values; None asks with a dialog when the option has inputs.

        Returns:
            The started runs.
        """
        targets = self.targets.ticked()
        problem = self.launcher.problem(targets)
        if problem:
            show_error(self, option.title, problem)
            return []
        if values is None:
            values = self.launcher.ask_values(option, self)
            if values is None:
                return []
        button = self.buttons.get(option.title)
        if button is not None:
            button.setStyleSheet("")
        return self.launcher.start(option, targets, values)


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
