# template: Operations menu as a form: pick an option, fill its inputs on the page, see per-device results in a table
"""$title page (plugin).

Generated by tools/new_page.py from the "menu_form" template: the menu
hooks (project.json -> menu_hooks) with the inputs on the page instead of in a
pop-up. Pick an option in the list; its description and inputs appear on the
right; press Run. Each device's outcome is added to the results table, and the
full detail goes to the log.

Use it as a tab, or as step 4 of the Session Workflow:
``python tools/new_page.py <key> "<Title>" --template menu_form --workflow``.
Add columns to the results table in ``_on_finished()``.
"""

from __future__ import annotations

import time
from typing import Any

from PySide6.QtCore import Qt
from PySide6.QtGui import QColor
from PySide6.QtWidgets import (
    QGroupBox,
    QLabel,
    QListWidget,
    QListWidgetItem,
    QPushButton,
    QSplitter,
    QTableWidget,
    QTableWidgetItem,
    QVBoxLayout,
    QWidget,
)

from app.core.services.menu_hooks import MenuOption
from app.ui.styles import theme
from app.ui.widgets.common import PageHeader, configure_table, show_error
from app.ui.widgets.hook_widgets import DeviceTargets, HookLauncher, HookLog, ParamForm, WorkflowStatus, load_options

STATE_COLORS = {"done": "OK", "failed": "ERROR", "error": "ERROR", "cancelled": "WARN"}


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None, embedded: bool = False) -> None:
        """Build the devices, the option list, the option form, the results and the log.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
            embedded: Shown as step 4 of the Session Workflow (no title or margins).
        """
        super().__init__(parent)
        self.ctx = ctx
        self.wf = ctx.workflow
        self.options: list[MenuOption] = []

        layout = QVBoxLayout(self)
        layout.setContentsMargins(*((0, 0, 0, 0) if embedded else (18, 14, 18, 14)))
        header = PageHeader("$title", "Pick an option, fill in its inputs and run it on the ticked devices.")
        if embedded:
            header.findChild(QWidget, "PageTitle").hide()
        for text, slot in (("Reload hooks", self.reload_hooks), ("Stop all", lambda: self.launcher.stop_all())):
            button = QPushButton(text)
            button.clicked.connect(slot)
            header.actions.addWidget(button)
        layout.addWidget(header)
        self.status = WorkflowStatus(self.wf)
        layout.addWidget(self.status)

        split = QSplitter()
        left = QSplitter(Qt.Orientation.Vertical)
        self.targets = DeviceTargets(self.wf)
        left.addWidget(self.targets)
        options_box = QGroupBox("Options")
        olayout = QVBoxLayout(options_box)
        self.list = QListWidget()
        self.list.currentItemChanged.connect(lambda item, _p: self.show_option(item))
        olayout.addWidget(self.list)
        left.addWidget(options_box)
        left.setStretchFactor(1, 2)
        split.addWidget(left)

        right = QWidget()
        rlayout = QVBoxLayout(right)
        rlayout.setContentsMargins(0, 0, 0, 0)
        detail = QGroupBox("Option")
        dlayout = QVBoxLayout(detail)
        self.title = QLabel("Pick an option")
        self.title.setObjectName("PageTitle")
        self.description = QLabel("")
        self.description.setObjectName("Dim")
        self.description.setWordWrap(True)
        self.form = ParamForm()
        self.run_button = QPushButton("Run on ticked devices")
        self.run_button.setObjectName("Primary")
        self.run_button.setEnabled(False)
        self.run_button.clicked.connect(lambda: self.run_option(self.current_option(), self.form.values()))
        for widget in (self.title, self.description, self.form, self.run_button):
            dlayout.addWidget(widget)
        rlayout.addWidget(detail)
        self.results = QTableWidget(0, 4)
        self.results.setHorizontalHeaderLabels(["Time", "Device", "Option", "Result"])
        configure_table(self.results)
        rlayout.addWidget(self.results, 2)
        self.log = HookLog()
        rlayout.addWidget(self.log, 1)
        split.addWidget(right)
        split.setStretchFactor(0, 1)
        split.setStretchFactor(1, 2)
        layout.addWidget(split, 1)

        self.launcher = HookLauncher(self.wf, self.log, self)
        self.launcher.run_finished.connect(self._on_finished)
        self.reload_hooks()

    @property
    def runs(self) -> list:
        """Hook runs still in progress."""
        return self.launcher.runs

    def reload_hooks(self) -> None:
        """Re-import the hook files and refill the option list."""
        self.options, problems = load_options(self.ctx.menu_hooks)
        self.list.clear()
        category = None
        for number, option in enumerate(self.options, start=1):
            if option.category != category:
                category = option.category
                heading = QListWidgetItem(category)
                heading.setFlags(Qt.ItemFlag.NoItemFlags)
                heading.setForeground(QColor(theme.TEXT_DIM))
                self.list.addItem(heading)
            item = QListWidgetItem(f"  {number}. {option.title}")
            item.setData(Qt.ItemDataRole.UserRole, number - 1)
            item.setToolTip(option.description)
            self.list.addItem(item)
        for problem in problems:
            self.log.append("error", f"hooks: {problem}")

    def current_option(self) -> MenuOption | None:
        """Return the option selected in the list, or None."""
        item = self.list.currentItem()
        index = item.data(Qt.ItemDataRole.UserRole) if item is not None else None
        return self.options[index] if index is not None else None

    def show_option(self, item) -> None:
        """Show the selected option's description and inputs.

        Args:
            item: Selected list row.
        """
        option = self.current_option()
        self.title.setText(option.title if option else "Pick an option")
        self.description.setText(option.description if option else "")
        last = self.launcher.last_values.get(f"{option.module}:{option.title}", {}) if option else {}
        self.form.set_option(option, last)
        self.run_button.setEnabled(option is not None)

    def _on_finished(self, run) -> None:
        """Add a finished run to the results table.

        Args:
            run: The finished hook run.
        """
        row = self.results.rowCount()
        self.results.insertRow(row)
        values = [time.strftime("%H:%M:%S"), run.device.name, run.option.title, run.state.upper()]
        for column, text in enumerate(values):
            self.results.setItem(row, column, QTableWidgetItem(text))
        color = getattr(theme, STATE_COLORS.get(run.state, "WARN"))
        self.results.item(row, 3).setForeground(QColor(color))
        self.results.scrollToBottom()

    # -- used by the Session Workflow (right-click a device -> Run operation) --
    def set_targets(self, peers: list[str]) -> None:
        """Tick exactly these devices.

        Args:
            peers: Device addresses.
        """
        self.targets.set_targets(peers)

    def ticked_peers(self) -> list[str]:
        """Return the addresses of the ticked devices."""
        return self.targets.ticked_peers()

    def run_option(self, option: MenuOption | None, values: dict[str, Any] | None = None) -> list:
        """Run an option on every ticked device.

        Args:
            option: Option to run.
            values: Input values; None selects the option so its inputs can be filled in.

        Returns:
            The started runs.
        """
        if option is None:
            return []
        if values is None and option.params:
            for row in range(self.list.count()):
                if self.list.item(row).data(Qt.ItemDataRole.UserRole) == self.options.index(option):
                    self.list.setCurrentRow(row)
            return []
        targets = self.targets.ticked()
        problem = self.launcher.problem(targets)
        if problem:
            show_error(self, option.title, problem)
            return []
        return self.launcher.start(option, targets, values or {})


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
