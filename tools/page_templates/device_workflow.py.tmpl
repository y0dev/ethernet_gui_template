# Steps
# -----------------------------------------------------------------------------
class ServerStep(Step):
    title = "Server"
    hint = "Devices connect to this server. Results are stored in the database shown below."
    blocker = "Start the server first."

    def build(self) -> None:
        """Add the address fields, Start/Stop and the status line."""
        cfg = self.ctx.config
        form = QFormLayout()
        self.host = QLineEdit(cfg.workflow_server_host)
        self.port = QSpinBox()
        self.port.setRange(1, 65535)
        self.port.setValue(cfg.workflow_server_port)
        self.database = QLabel("")
        form.addRow("Listen on", self.host)
        form.addRow("Port", self.port)
        form.addRow("Database", self.database)
        self.layout_.addLayout(form)
        start = QPushButton("Start server")
        start.setObjectName("Primary")
        start.clicked.connect(self.start)
        stop = QPushButton("Stop")
        stop.clicked.connect(self.wf.stop_server)
        self.layout_.addLayout(button_row(start, stop))
        self.status = QLabel("")
        self.layout_.addWidget(self.status)
        self.layout_.addStretch(1)
        self.wf.server_state_changed.connect(lambda _s: (self.refresh(), self.changed.emit()))

    def start(self) -> None:
        """Confirm the current database and start the server with the configured framing."""
        cfg = self.ctx.config
        try:
            self.wf.use_current_database()
            self.wf.start_server(self.host.text().strip(), self.port.value(),
                                 Transport(cfg.workflow_server_transport), cfg.workflow_server_framing)
        except WorkflowError as exc:
            show_error(self, "Start server", exc)
        self.refresh()
        self.changed.emit()

    def is_done(self) -> bool:
        """Done while the server is running on a confirmed database."""
        return self.wf.server_running and self.wf.database_confirmed

    def refresh(self) -> None:
        """Show the database path and the server state."""
        self.database.setText(str(self.ctx.db.path))
        running = self.wf.server_running
        self.status.setText(f"✓ Listening on {self.wf.server_address()}" if running else "Stopped")
        self.status.setStyleSheet(f"color: {theme.OK if running else theme.TEXT_DIM};")


class DevicesStep(Step):
    title = "Devices"
    hint = "Tick the devices to test, name the session and start recording."
    blocker = "Start a session first."

    def build(self) -> None:
        """Add the device list and the session controls."""
        self.devices = QListWidget()
        self.layout_.addWidget(self.devices, 1)
        self.session_name = QLineEdit()
        self.session_name.setPlaceholderText("Session name, e.g. Batch 12 acceptance")
        start = QPushButton("Start session")
        start.setObjectName("Primary")
        start.clicked.connect(self.start_session)
        row = QHBoxLayout()
        row.addWidget(self.session_name, 1)
        row.addWidget(start)
        self.layout_.addLayout(row)
        self.status = QLabel("")
        self.layout_.addWidget(self.status)
        self.wf.devices_changed.connect(self.refresh)
        self.wf.session_changed.connect(lambda _s: (self.refresh(), self.changed.emit()))

    def selected_peers(self) -> list[str]:
        """Return the addresses of the ticked devices."""
        return checked_data(self.devices)

    def start_session(self) -> None:
        """Start recording a session."""
        try:
            self.wf.start_session(self.session_name.text().strip())
        except WorkflowError as exc:
            show_error(self, "Start session", exc)

    def is_done(self) -> bool:
        """Done once a session is recording."""
        return self.wf.session_id is not None

    def refresh(self) -> None:
        """Refill the device list, keeping the ticks."""
        ticked = set(self.selected_peers())
        first_fill = self.devices.count() == 0
        self.devices.clear()
        for device in self.wf.connected_devices():
            if not device.connected:
                continue
            item = QListWidgetItem(f"{device.label}    ({device.peer})")
            item.setData(Qt.ItemDataRole.UserRole, device.peer)
            item.setCheckState(Qt.CheckState.Checked if first_fill or device.peer in ticked
                               else Qt.CheckState.Unchecked)
            self.devices.addItem(item)
        if self.wf.session_id is not None:
            self.status.setText(f"✓ Recording session {self.wf.session_id}")
            self.status.setStyleSheet(f"color: {theme.OK};")
        else:
            self.status.setText(f"{self.devices.count()} device(s) connected")
            self.status.setStyleSheet("")


class RunStep(Step):
    title = "Run"
    hint = "Tick operations and run them on the ticked devices. Each result is stored as it finishes."

    def build(self) -> None:
        """Add the operations list, the Run button and the results table."""
        self.operations = QListWidget()
        self.operations.setMaximumHeight(180)
        self.layout_.addWidget(self.operations)
        run = QPushButton("Run ticked operations")
        run.setObjectName("Primary")
        run.clicked.connect(self.run)
        load = QPushButton("Import command set…")
        load.clicked.connect(self.import_command_set)
        self.layout_.addLayout(button_row(run, load))
        self.results = RecordTableModel([
            Column("executed_at", "Time", fmt=format_timestamp), Column("device_name", "Device"),
            Column("operation_name", "Operation"),
            Column("status", "Result", fmt=lambda s: s.upper(), color=lambda s: RESULT_COLORS.get(s)),
            Column("latency_ms", "Latency", fmt=lambda v: "-" if v is None else f"{v:.1f} ms"),
            Column("response", "Response", fmt=lambda r: "-" if r is None else to_ascii(bytes(r))),
            Column("message", "Note"),
        ])
        view = QTableView()
        view.setModel(self.results)
        configure_table(view)
        self.layout_.addWidget(view, 1)
        self.ctx.operations.result_ready.connect(self.add_result)
        self.wf.session_changed.connect(lambda _s: self.results.set_records([]))

    def run(self) -> None:
        """Queue the ticked operations on the devices ticked in the Devices step."""
        ops = checked_data(self.operations)
        try:
            self.wf.run_operations(self.page.step(DevicesStep).selected_peers(), ops)
        except WorkflowError as exc:
            show_error(self, "Run", exc)

    def add_result(self, row: dict) -> None:
        """Append a finished result of the current session.

        Args:
            row: Result row from the operation runner.
        """
        if row.get("session_id") == self.wf.session_id:
            self.results.set_records([*self.results.records, row])

    def import_command_set(self) -> None:
        """Merge a command set JSON file (``{"operations": [...]}`` or a list) into the menu."""
        path, _ = QFileDialog.getOpenFileName(self, "Import command set",
                                              str(PROJECT_ROOT / "resources" / "command_sets"),
                                              "Command set (*.json)")
        if not path:
            return
        try:
            data = json.loads(Path(path).read_text(encoding="utf-8"))
            self.wf.import_operations(data["operations"] if isinstance(data, dict) else data)
        except (OSError, ValueError, KeyError, TypeError) as exc:
            show_error(self, "Import command set", f"{type(exc).__name__}: {exc}")
        self.refresh()

    def refresh(self) -> None:
        """Refill the operations menu, keeping the ticks."""
        ticked = {op.name for op in checked_data(self.operations)}
        self.operations.clear()
        for op in self.wf.list_operations():
            item = QListWidgetItem(f"{op.category} / {op.name}")
            item.setData(Qt.ItemDataRole.UserRole, op)
            item.setCheckState(Qt.CheckState.Checked if op.name in ticked else Qt.CheckState.Unchecked)
            self.operations.addItem(item)
        if not self.operations.count():
            self.operations.addItem("(no operations yet: Import command set…)")


class FinishStep(Step):
    title = "Finish"
    hint = "Check the totals and what was stored, then finish the session."

    def build(self) -> None:
        """Add the totals, the database browser and Finish session."""
        self.summary = QLabel("")
        self.summary.setWordWrap(True)
        self.layout_.addWidget(self.summary)
        view = QPushButton("View database contents…")
        view.clicked.connect(self.view_database)
        finish = QPushButton("Finish session")
        finish.setObjectName("Primary")
        finish.clicked.connect(lambda: (self.wf.end_session(), self.refresh()))
        self.layout_.addLayout(button_row(finish, view))
        self.layout_.addStretch(1)

    def refresh(self) -> None:
        """Count the results of this session by outcome."""
        records = self.page.step(RunStep).results.records
        counts = Counter(row["status"] for row in records)
        totals = ", ".join(f"{count} {status}" for status, count in sorted(counts.items())) or "no results yet"
        session = self.wf.session_id
        self.summary.setText(f"Session: {session if session is not None else 'finished'}\n"
                             f"Results: {totals}\nDatabase: {self.ctx.db.path}")

    def view_database(self) -> None:
        """Show the database's tables in a read-only browser, starting on the results."""
        dialog = QDialog(self)
        dialog.setWindowTitle(f"Database contents: {self.ctx.db.path.name}")
        dialog.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
        dialog.resize(1000, 600)
        layout = QVBoxLayout(dialog)
        editor = TableEditor(self.ctx.db, read_only=True, parent=dialog)
        editor.show_workbench.setChecked(True)
        editor.chooser.setCurrentText("operation_results")
        layout.addWidget(editor, 1)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
        buttons.rejected.connect(dialog.close)
        layout.addWidget(buttons)
        dialog.show()


#: The steps, in order.
STEPS: list[type[Step]] = [ServerStep, DevicesStep, RunStep, FinishStep]


# -----------------------------------------------------------------------------
# The page: step bar, the steps (one visible at a time) and Back / Next.
# Usually nothing to change below this line.
# -----------------------------------------------------------------------------
class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None) -> None:
        """Build the step bar, the steps and the navigation.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
        """
        super().__init__(parent)
        self.ctx = ctx
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 14, 18, 14)
        layout.addWidget(PageHeader("$title", " → ".join(step.title for step in STEPS)))

        bar = QFrame()
        bar.setObjectName("Card")
        row = QHBoxLayout(bar)
        row.setContentsMargins(8, 6, 8, 6)
        self.stack = QStackedWidget()
        self.steps: list[Step] = []
        self.step_buttons: list[QPushButton] = []
        for i, step_class in enumerate(STEPS):
            step = step_class(ctx, self)
            step.changed.connect(self.update_steps)
            self.steps.append(step)
            self.stack.addWidget(step)
            button = QPushButton(f"{i + 1}  {step.title}")
            button.setCheckable(True)
            button.setMinimumWidth(120)
            button.clicked.connect(lambda _c=False, n=i: self.go_to(n))
            self.step_buttons.append(button)
            row.addWidget(button)
            if i < len(STEPS) - 1:
                arrow = QLabel("›")
                arrow.setObjectName("Dim")
                row.addWidget(arrow)
        row.addStretch(1)
        layout.addWidget(bar)
        layout.addWidget(self.stack, 1)

        nav = QHBoxLayout()
        self.back = QPushButton("‹ Back")
        self.back.clicked.connect(lambda: self.go_to(self.stack.currentIndex() - 1))
        self.hint = QLabel("")
        self.next = QPushButton("Next ›")
        self.next.setObjectName("Primary")
        self.next.clicked.connect(lambda: self.go_to(self.stack.currentIndex() + 1))
        nav.addWidget(self.back)
        nav.addStretch(1)
        nav.addWidget(self.hint)
        nav.addWidget(self.next)
        layout.addLayout(nav)
        self.go_to(0)

    def step(self, step_class: type[Step]) -> Step:
        """Return the step of the given class, e.g. ``self.page.step(DevicesStep)``.

        Args:
            step_class: A class listed in ``STEPS``.

        Returns:
            The step instance.
        """
        return next(s for s in self.steps if isinstance(s, step_class))

    def blocker(self, index: int) -> str:
        """Explain why a step cannot be opened yet.

        Args:
            index: Zero-based step index.

        Returns:
            The first unfinished earlier step's message, or ``""``.
        """
        return next((s.blocker for s in self.steps[:index] if not s.is_done()), "")

    def go_to(self, index: int) -> None:
        """Show a step; moving forward into a locked step is refused with the reason.

        Args:
            index: Zero-based step index; clamped to the valid range.
        """
        index = max(0, min(len(self.steps) - 1, index))
        reason = self.blocker(index)
        if reason and index > self.stack.currentIndex():
            self.hint.setText(reason)
            self.hint.setStyleSheet(f"color: {theme.WARN};")
            return
        self.stack.setCurrentIndex(index)
        self.steps[index].refresh()
        self.update_steps()

    def update_steps(self) -> None:
        """Redraw the step bar and the Back/Next buttons from each step's state."""
        current = self.stack.currentIndex()
        for i, button in enumerate(self.step_buttons):
            button.setChecked(i == current)
            button.setEnabled(not self.blocker(i))
            mark = "✓" if i < current and self.steps[i].is_done() else str(i + 1)
            button.setText(f"{mark}  {self.steps[i].title}")
        self.back.setEnabled(current > 0)
        self.next.setEnabled(current < len(self.steps) - 1)
        reason = self.blocker(current + 1) if current < len(self.steps) - 1 else ""
        self.hint.setText(reason)
        self.hint.setStyleSheet(f"color: {theme.TEXT_DIM};")


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
