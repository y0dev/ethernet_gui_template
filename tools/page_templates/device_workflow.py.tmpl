RESULT_COLORS = {"passed": theme.OK, "failed": theme.ERROR, "error": theme.ERROR,
                 "timeout": theme.WARN, "sent": theme.TEXT_DIM}


class Step(QWidget):
    """One step of the workflow. Subclass it and list the subclass in ``STEPS``."""

    title = "Step"
    hint = ""
    #: shown when the user tries to move past this step before it is done
    blocker = "Finish this step first."
    #: emit whenever is_done() may have changed
    changed = Signal()

    def __init__(self, ctx, page: $cls) -> None:
        """Create the step and build its widgets.

        Args:
            ctx: Application context with every service.
            page: The workflow page, for reaching the other steps.
        """
        super().__init__()
        self.ctx = ctx
        self.wf = ctx.workflow
        self.page = page
        self.layout_ = QVBoxLayout(self)
        if self.hint:
            hint = QLabel(self.hint)
            hint.setObjectName("Dim")
            hint.setWordWrap(True)
            self.layout_.addWidget(hint)
        self.build()

    def build(self) -> None:
        """Add this step's widgets to ``self.layout_``."""

    def is_done(self) -> bool:
        """Report whether the user may move on to the next step."""
        return True

    def refresh(self) -> None:
        """Update the step from current data; called each time it is shown."""


def checked_data(widget: QListWidget) -> list:
    """Return the data of every ticked item in a list.

    Args:
        widget: List with checkable items.

    Returns:
        Each ticked item's ``UserRole`` data.
    """
    return [widget.item(i).data(Qt.ItemDataRole.UserRole) for i in range(widget.count())
            if widget.item(i).checkState() == Qt.CheckState.Checked]


def button_row(*buttons: QWidget) -> QHBoxLayout:
    """Lay buttons out left-aligned in a row.

    Args:
        *buttons: Widgets to place.

    Returns:
        The row layout.
    """
    row = QHBoxLayout()
    for button in buttons:
        row.addWidget(button)
    row.addStretch(1)
    return row


