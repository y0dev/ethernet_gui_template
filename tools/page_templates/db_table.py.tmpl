# template: View and edit a database table (use --table, optionally --database)
"""$title page (plugin).

Generated by tools/new_page.py from the "db_table" template.  It shows the
table ``TABLE`` in a grid you can search, page through and edit in place;
Save writes every change in one transaction.

* ``TABLE``: the table to show.  Leave it empty to get a chooser with every
  table of the database (the workbench's own tables are hidden).
* ``DATABASE``: path of an SQLite file, relative to the project root.  Leave
  it empty to use the application database (``ctx.db``).  A file named here
  is opened as it is: the workbench tables are not added to it.
* ``READ_ONLY``: True for a view-only page.

The grid is :class:`app.ui.widgets.table_editor.TableEditor`; use it directly
in your own pages too.
"""

from __future__ import annotations

from PySide6.QtWidgets import QLabel, QVBoxLayout, QWidget

from app.ui.widgets.common import PageHeader
from app.ui.widgets.table_editor import TableEditor, open_database_file

TABLE = "$table"
DATABASE = "$database"
READ_ONLY = False


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None) -> None:
        """Open the database and show the table editor.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
        """
        super().__init__(parent)
        self.ctx = ctx
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 14, 18, 14)
        layout.addWidget(PageHeader("$title", f"{TABLE or 'Tables'} in {DATABASE or 'the application database'}"))
        self.editor: TableEditor | None = None
        try:
            self.db = open_database_file(str(ctx.config.resolve(DATABASE))) if DATABASE else ctx.db
        except Exception as exc:
            message = QLabel(f"Cannot open {DATABASE}: {exc}")
            message.setWordWrap(True)
            layout.addWidget(message)
            layout.addStretch(1)
            return
        self.editor = TableEditor(self.db, TABLE, read_only=READ_ONLY)
        layout.addWidget(self.editor, 1)

    def showEvent(self, event) -> None:  # noqa: N802
        """Reload the rows whenever the page becomes visible, keeping unsaved edits.

        Args:
            event: Qt show event.
        """
        super().showEvent(event)
        if self.editor is not None and not self.editor.model.has_changes():
            self.editor.reload(ask=False)


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
