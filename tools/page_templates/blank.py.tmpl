# template: Empty page with a header, for building your own layout
"""$title page (plugin).

Generated by tools/new_page.py from the "blank" template.  Every service is
on ``ctx`` (app/context.py).  Keep logic in a service or function you can
test without the GUI.
"""

from __future__ import annotations

from PySide6.QtWidgets import QLabel, QVBoxLayout, QWidget

from app.ui.widgets.common import PageHeader


class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None) -> None:
        """Build the page header and an empty content area.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
        """
        super().__init__(parent)
        self.ctx = ctx
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 14, 18, 14)
        layout.addWidget(PageHeader("$title", "Describe what this page is for."))
        self.content = QVBoxLayout()
        layout.addLayout(self.content, 1)
        self.status = QLabel("Add your widgets to self.content.")
        self.status.setObjectName("Dim")
        self.content.addWidget(self.status)
        self.content.addStretch(1)


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
