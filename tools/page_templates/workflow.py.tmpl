# template: Guided step-by-step page: step bar, Back/Next, each step unlocks when the one before is done
"""$title page (plugin).

Generated by tools/new_page.py from the "workflow" template: a guided page
like the built-in Session Workflow, with your own steps.

How it works:

* Each step is a ``Step`` subclass with a ``title``, ``build()`` for its
  widgets, ``is_done()`` (may the user move past it?) and ``refresh()``
  (called each time it is shown). Call ``self.changed.emit()`` whenever
  ``is_done()`` may have changed, so the step bar updates.
* ``STEPS`` lists the step classes in order. Add, remove or reorder them.
* A step reaches the others through ``self.page.steps`` and the services
  through ``self.ctx`` (``ctx.db``, ``ctx.connections``, ``ctx.workflow`` ...).

The three example steps (Set up, Run, Review) show the pattern: replace
their contents with your own.
"""

from __future__ import annotations

import time

from PySide6.QtCore import Qt, Signal
from PySide6.QtWidgets import (
    QDialog,
    QDialogButtonBox,
    QFormLayout,
    QFrame,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QPushButton,
    QSpinBox,
    QStackedWidget,
    QVBoxLayout,
    QWidget,
)

from app.ui.styles import theme
from app.ui.widgets.common import HexView, PageHeader
from app.ui.widgets.table_editor import TableEditor


class Step(QWidget):
    """One step of the workflow. Subclass it and list the subclass in ``STEPS``."""

    #: shown in the step bar
    title = "Step"
    #: shown above the step's widgets
    hint = ""
    #: shown when the user tries to move past this step before it is done
    blocker = "Finish this step first."
    #: emit whenever is_done() may have changed
    changed = Signal()

    def __init__(self, ctx, page: $cls) -> None:
        """Create the step and build its widgets.

        Args:
            ctx: Application context with every service.
            page: The workflow page, for reaching the other steps.
        """
        super().__init__()
        self.ctx = ctx
        self.page = page
        self.layout_ = QVBoxLayout(self)
        if self.hint:
            hint = QLabel(self.hint)
            hint.setObjectName("Dim")
            hint.setWordWrap(True)
            self.layout_.addWidget(hint)
        self.build()

    def build(self) -> None:
        """Add this step's widgets to ``self.layout_``."""

    def is_done(self) -> bool:
        """Report whether the user may move on to the next step.

        Returns:
            True when the step is complete.
        """
        return True

    def refresh(self) -> None:
        """Update the step from current data; called each time it is shown."""


# -----------------------------------------------------------------------------
# Example steps: replace these with your own.
# -----------------------------------------------------------------------------
class SetupStep(Step):
    title = "Set up"
    hint = "Enter the settings for this run."
    blocker = "Enter a run name first."

    def build(self) -> None:
        """Add the settings form."""
        form = QFormLayout()
        self.name = QLineEdit()
        self.name.setPlaceholderText("e.g. Board 7 bring-up")
        self.name.textChanged.connect(lambda _t: self.changed.emit())
        self.repeat = QSpinBox()
        self.repeat.setRange(1, 100)
        self.repeat.setValue(3)
        form.addRow("Run name", self.name)
        form.addRow("Repeat", self.repeat)
        self.layout_.addLayout(form)
        self.layout_.addStretch(1)

    def is_done(self) -> bool:
        """Done once a run name is entered."""
        return bool(self.name.text().strip())


class RunStep(Step):
    title = "Run"
    hint = "Run the work and watch its output."
    blocker = "Run at least once first."

    def build(self) -> None:
        """Add the Run button and the output log."""
        self.runs = 0
        run = QPushButton("Run")
        run.setObjectName("Primary")
        run.clicked.connect(self.run)
        row = QHBoxLayout()
        row.addWidget(run)
        row.addStretch(1)
        self.layout_.addLayout(row)
        self.output = HexView()
        self.layout_.addWidget(self.output, 1)

    def run(self) -> None:
        """Do the work. Replace the body with your own (send frames, query ctx.db, ...)."""
        setup = self.page.step(SetupStep)
        for i in range(setup.repeat.value()):
            self.output.appendPlainText(f"{time.strftime('%H:%M:%S')}  {setup.name.text()}: pass {i + 1}")
        self.runs += 1
        self.changed.emit()

    def is_done(self) -> bool:
        """Done after at least one run."""
        return self.runs > 0


class ReviewStep(Step):
    title = "Review"
    hint = "Check the outcome and what is stored in the database."

    def build(self) -> None:
        """Add the summary and the database browser button."""
        self.summary = QLabel("")
        self.summary.setWordWrap(True)
        self.layout_.addWidget(self.summary)
        view = QPushButton("View database contents…")
        view.clicked.connect(self.view_database)
        row = QHBoxLayout()
        row.addWidget(view)
        row.addStretch(1)
        self.layout_.addLayout(row)
        self.layout_.addStretch(1)

    def refresh(self) -> None:
        """Summarise the earlier steps."""
        setup, run = self.page.step(SetupStep), self.page.step(RunStep)
        self.summary.setText(f"Run name: {setup.name.text()}\nRuns completed: {run.runs}\n"
                             f"Database: {self.ctx.db.path}")

    def view_database(self) -> None:
        """Show the application database's tables in a read-only browser."""
        dialog = QDialog(self)
        dialog.setWindowTitle(f"Database contents: {self.ctx.db.path.name}")
        dialog.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose)
        dialog.resize(1000, 600)
        layout = QVBoxLayout(dialog)
        editor = TableEditor(self.ctx.db, read_only=True, parent=dialog)
        editor.show_workbench.setChecked(True)
        layout.addWidget(editor, 1)
        buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
        buttons.rejected.connect(dialog.close)
        layout.addWidget(buttons)
        dialog.show()


#: The steps, in order.
STEPS: list[type[Step]] = [SetupStep, RunStep, ReviewStep]


# -----------------------------------------------------------------------------
# The page: step bar, the steps (one visible at a time) and Back / Next.
# Usually nothing to change below this line.
# -----------------------------------------------------------------------------
class $cls(QWidget):
    def __init__(self, ctx, parent: QWidget | None = None) -> None:
        """Build the step bar, the steps and the navigation.

        Args:
            ctx: Application context with every service.
            parent: Optional parent widget.
        """
        super().__init__(parent)
        self.ctx = ctx
        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 14, 18, 14)
        layout.addWidget(PageHeader("$title", " → ".join(step.title for step in STEPS)))

        bar = QFrame()
        bar.setObjectName("Card")
        row = QHBoxLayout(bar)
        row.setContentsMargins(8, 6, 8, 6)
        self.stack = QStackedWidget()
        self.steps: list[Step] = []
        self.step_buttons: list[QPushButton] = []
        for i, step_class in enumerate(STEPS):
            step = step_class(ctx, self)
            step.changed.connect(self.update_steps)
            self.steps.append(step)
            self.stack.addWidget(step)
            button = QPushButton(f"{i + 1}  {step.title}")
            button.setCheckable(True)
            button.setMinimumWidth(120)
            button.clicked.connect(lambda _c=False, n=i: self.go_to(n))
            self.step_buttons.append(button)
            row.addWidget(button)
            if i < len(STEPS) - 1:
                arrow = QLabel("›")
                arrow.setObjectName("Dim")
                row.addWidget(arrow)
        row.addStretch(1)
        layout.addWidget(bar)
        layout.addWidget(self.stack, 1)

        nav = QHBoxLayout()
        self.back = QPushButton("‹ Back")
        self.back.clicked.connect(lambda: self.go_to(self.stack.currentIndex() - 1))
        self.hint = QLabel("")
        self.next = QPushButton("Next ›")
        self.next.setObjectName("Primary")
        self.next.clicked.connect(lambda: self.go_to(self.stack.currentIndex() + 1))
        nav.addWidget(self.back)
        nav.addStretch(1)
        nav.addWidget(self.hint)
        nav.addWidget(self.next)
        layout.addLayout(nav)
        self.go_to(0)

    def step(self, step_class: type[Step]) -> Step:
        """Return the step of the given class, e.g. ``self.page.step(SetupStep)``.

        Args:
            step_class: A class listed in ``STEPS``.

        Returns:
            The step instance.
        """
        return next(s for s in self.steps if isinstance(s, step_class))

    def blocker(self, index: int) -> str:
        """Explain why a step cannot be opened yet.

        Args:
            index: Zero-based step index.

        Returns:
            The first unfinished earlier step's message, or ``""``.
        """
        return next((s.blocker for s in self.steps[:index] if not s.is_done()), "")

    def go_to(self, index: int) -> None:
        """Show a step; moving forward into a locked step is refused with the reason.

        Args:
            index: Zero-based step index; clamped to the valid range.
        """
        index = max(0, min(len(self.steps) - 1, index))
        reason = self.blocker(index)
        if reason and index > self.stack.currentIndex():
            self.hint.setText(reason)
            self.hint.setStyleSheet(f"color: {theme.WARN};")
            return
        self.stack.setCurrentIndex(index)
        self.steps[index].refresh()
        self.update_steps()

    def update_steps(self) -> None:
        """Redraw the step bar and the Back/Next buttons from each step's state."""
        current = self.stack.currentIndex()
        for i, button in enumerate(self.step_buttons):
            button.setChecked(i == current)
            button.setEnabled(not self.blocker(i))
            mark = "✓" if i < current and self.steps[i].is_done() else str(i + 1)
            button.setText(f"{mark}  {self.steps[i].title}")
        self.back.setEnabled(current > 0)
        self.next.setEnabled(current < len(self.steps) - 1)
        reason = self.blocker(current + 1) if current < len(self.steps) - 1 else ""
        self.hint.setText(reason)
        self.hint.setStyleSheet(f"color: {theme.TEXT_DIM};")


def register(registry) -> None:
    """Plugin entry point: add this page to the registry.

    Args:
        registry: Page registry to add the page to.
    """
    registry.add_page("$key", "$title", $cls, description="$title")
